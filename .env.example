# Скопируйте этот файл в .env и вставьте свой ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Необязательно: основная модель Gemini (по умолчанию gemini-3.6-flash).
# Запасные подключаются сами: gemini-3.8-flash, gemini-flash-latest.
GEMINI_MODEL=

# Необязательно: насколько долго модель «думает» перед ответом.
# minimal | low | medium | high | default. По умолчанию low: примерно втрое быстрее, чем medium.
GEMINI_THINKING=

# Необязательно: через сколько секунд без ответа параллельно запускать запрос к запасной модели
# (по умолчанию 15 при low). 0 — не запускать, тогда запросов меньше, но ждать дольше.
GEMINI_HEDGE_SECONDS=

# Необязательно: порт локального сервера
PORT=3000
